{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/index.js -n \"SERVER,VITE\" -c \"blue,green\" \"npm run server\" \"npm run dev:vite\"",
    "dev:vite": "node node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "server": "node node_modules/tsx/dist/cli.mjs server.ts",
    "tunnel": "node scripts/tunnel.js",
    "dev:tunnel": "node node_modules/concurrently/dist/bin/index.js -n \"SERVER,VITE,TUNNEL\" -c \"blue,green,magenta\" \"npm run server\" \"npm run dev:vite\" \"npm run tunnel\"",
    "start": "npm run dev:tunnel",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "localtunnel": "^2.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "puppeteer": "^25.8.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
